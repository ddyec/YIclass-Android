        <item name="colorOnSecondaryContainer">#40455F</item>
        <item name="colorTertiary">#7D4F75</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FFD7F4</item>
        <item name="colorOnTertiaryContainer">#63385C</item>
