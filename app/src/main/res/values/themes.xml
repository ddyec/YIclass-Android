<resources>
    <!--
        Material 3 Expressive base theme.
        Colors are a full M3 tonal scheme generated from the YIClass brand seed #3657CE
        (primary T40 / container T90 / on-container T30, matching the Expressive token mapping).
        Users on Android 12+ can opt into wallpaper-based dynamic color in Settings.
    -->
    <style name="Base.Theme.YIClass" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <!-- Expressive shape scale -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.YIClass.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.YIClass.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.YIClass.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.YIClass.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.YIClass.ExtraLarge</item>

        <!-- Expressive component defaults used by programmatic views -->
        <item name="yiButtonFilledMedium">@style/Widget.YIClass.Button.Filled.Medium</item>
        <item name="yiButtonTonalMedium">@style/Widget.YIClass.Button.Tonal.Medium</item>
        <item name="yiIconButtonTonalMedium">@style/Widget.YIClass.IconButton.Tonal.Medium</item>
        <item name="yiTextField">@style/Widget.YIClass.TextField</item>
        <item name="chipStyle">@style/Widget.Material3.Chip.Suggestion</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.YIClass.BottomSheetDialog</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.YIClass" parent="Base.Theme.YIClass">
        <item name="colorPrimary">#3254CB</item>
